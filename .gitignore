# ---------------------------------------------------------------------------
# SpotFinder — repo-root .gitignore
# ---------------------------------------------------------------------------

# --- Python (pipeline + backend) -------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
.eggs/

# --- Node (frontend) -------------------------------------------------------
node_modules/
dist/
build/

# Built frontend copied into the backend image (Docker COPY target / local test).
backend/static/

# --- Environment files -----------------------------------------------------
# Ignore real secrets, but KEEP the committed .env.example templates.
.env
.env.local
!.env.example
!*/.env.example

# --- OS cruft --------------------------------------------------------------
.DS_Store

# --- Logs ------------------------------------------------------------------
*.log

# --- Pipeline downloads & intermediates ------------------------------------
# Raw downloads and large intermediate artefacts are regenerated by the
# offline pipeline and must never be committed.
pipeline/raw/
pipeline/data/

# Downloaded Statbel / OSM artefacts (any depth under pipeline/)
pipeline/**/*.zip
pipeline/**/*.xlsx
pipeline/**/*.shp
pipeline/**/*.dbf
pipeline/**/*.shx
pipeline/**/*.prj
pipeline/**/*.cpg
pipeline/**/*.gml
pipeline/**/*.parquet
pipeline/*.parquet

# ---------------------------------------------------------------------------
# Explicitly TRACKED: the backend must ship with its data file.
# backend/data/antwerpen.geojson is committed (currently a synthetic sample)
# so the deployed backend always has something to serve.
!backend/data/antwerpen.geojson

# Playwright MCP artifacts
.playwright-mcp/
