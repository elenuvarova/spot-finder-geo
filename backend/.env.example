# SpotFinder backend environment variables.
# Copy to .env for local dev (or set these in the Render dashboard).

# Gemini API key — backend only, never commit / never in frontend.
# Leave blank to run with the template-only explainer (graceful degradation).
GEMINI_API_KEY=

# Gemini model used by the AI explainer layer.
GEMINI_MODEL=gemini-2.5-flash-lite

# Comma-separated list of allowed CORS origins. Default "*" for local dev.
# In production set this to your real frontend URL (Vercel/Netlify), not "*".
FRONTEND_ORIGIN=http://localhost:5173
